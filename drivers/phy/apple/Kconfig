config PHY_APPLE_ATC
	tristate "Apple Type-C PHY"
	depends on (ARM64 && ARCH_APPLE) || (COMPILE_TEST && !GENERIC_ATOMIC64)
	depends on TYPEC
	depends on USB || !USB
	select GENERIC_PHY
	select APPLE_TUNABLE
	help
	  Enable this to add support for the Apple Type-C PHY found in
	  Apple Silicon M-series SoCs. This PHY supports USB2,
	  USB3, USB4, Thunderbolt, and DisplayPort.

	  If M is selected the module will be called 'phy-apple-atc'.

config PHY_APPLE_ATC_KUNIT_TEST
	bool "KUnit tests for the Apple Type-C PHY" if !KUNIT_ALL_TESTS
	depends on PHY_APPLE_ATC && KUNIT
	depends on PHY_APPLE_ATC=m || KUNIT=y
	default KUNIT_ALL_TESTS
	help
	  Build the KUnit tests for the Type-C mux decisions of the Apple
	  Type-C PHY driver into the driver. They check how Type-C states
	  map to PHY modes, which mux updates may skip the lane and PIPE
	  work, and that a port behind a fixed hub has the controller's
	  SuperSpeed port off while its PIPE moves. The tests need no
	  hardware and run when the driver is loaded.

	  Also check tunnel qualification, T8122 link rates, drive presets
	  and lane mapping using fixtures without PHY hardware.

	  If unsure, say N.

config PHY_APPLE_DPTX
	tristate "Apple DPTX PHY"
	depends on ARCH_APPLE || COMPILE_TEST
	select GENERIC_PHY
	help
	  Enable this to add support for the Apple DPTX PHY found on Apple SoCs
	  such as the M2.
	  This driver provides support for DisplayPort and is used on the
	  Mac mini (M2 and M2 Pro, 2023).

config PHY_APPLE_T8152_USB2
	tristate "Apple T8152 fixed-host USB2 PHY"
	default ARCH_APPLE
	depends on ARCH_APPLE || COMPILE_TEST
	depends on PM
	select GENERIC_PHY
	select APPLE_TUNABLE
	help
	  Enable the USB2-only PHY for fixed host ports on Apple T8152.
	  This does not configure the USB3 or USB4 lanes.
