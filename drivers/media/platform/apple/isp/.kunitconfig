# Full driver suites on arm64 (requires an arm64 QEMU):
# ./tools/testing/kunit/kunit.py run --arch=arm64 \
#   --kunitconfig=drivers/media/platform/apple/isp
# The independent IPC layout suite can also run alone on UML.
CONFIG_KUNIT=y
CONFIG_COMPILE_TEST=y
CONFIG_OF=y
CONFIG_PM=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEO_APPLE_ISP=y
CONFIG_VIDEO_APPLE_ISP_KUNIT_TEST=y
CONFIG_VIDEO_APPLE_ISP_IPC_LAYOUT_KUNIT_TEST=y
CONFIG_DRM=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_FW_LOADER=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_SPINLOCK=y
