# The qualified M3 Pro build's generated kernel files and libclc. build() stops
# when one of ours differs. libagx_shaders.c is compared through kernel-digest.py:
# the portable NIR kernels and program tables an M3 uses, without the M1/M2-only
# precompiled G13 binaries (their info header carries uninitialised padding, so
# that part differs from run to run).
_qualified_kernel_digest='8c5a6eb11747db4fcf06602750e827af14f6c0c9f953caa76eb65d8f72a33994 105'
_qualified=('f44305b94e884049d35d3934416a75571eb7bb0085e3593f8c04480956c02e30 deps/share/clc/spirv-mesa3d-.spv'
            'f725856fffbfe6dfbe6149a6a49cac407ab3a1c2eee9a7326c3dcdbd8987ee84 deps/share/clc/spirv64-mesa3d-.spv'
