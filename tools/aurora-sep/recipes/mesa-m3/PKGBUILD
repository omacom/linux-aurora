# Mesa profiles share one package and use explicit firmware/ABI admission.
# Legacy Honeykrisp/Zink remains under /opt/mesa-m3 for current14/Pro users.
# The J613 25G83 profile uses /opt/mesa-m3/25g83 for native GL only; its
# Vulkan directory is empty. Selection requires persistent administrator intent,
# the exact j613-25g83-hal200 token, firmware26.6.2 handoff and runtime HAL200/USC3.
# The J615 shares that profile experimentally: the session hook admits it only
# with /chosen asahi,j615-25g83-experimental="1" (share/mesa-m3/native25-boards).
# The package builds both sources sequentially and checks compiler definitions,
# generated kernels, queue sandbox behavior, TLS loading and native MRT clears.
# No profile selection substitutes another Mac's firmware or calibration.
pkgname=mesa-m3
pkgver=26.1.4.m3.2
pkgrel=8
_commit=7ff89a4da387bd561b78efd5f09c98ca8ae18538
pkgdesc="Mesa in /opt/mesa-m3 for the M3 Pro (G15S) and M3 (G15G) GPUs; used by uwsm sessions on T6030, and on T8122 when opted in"
arch=('aarch64')
url='https://github.com/iconidentify/aurora-linux'
license=('MIT' 'SGI-B-2.0' 'BSL-1.0' 'HPND-sell-variant' 'BSD-3-Clause' 'CC0-1.0 OR Apache-2.0'
         'LicenseRef-MLAA' 'Apache-2.0 WITH LLVM-exception')
install=mesa-m3.install
# Runtime and build packages. They are not listed in depends/makedepends because the
# lab builder image's package database lags the mirror (makepkg -s gets 404s); prepare()
# updates the throwaway build container and installs them instead. The package's own
# runtime depends are set in package_mesa-m3(), with the lowest versions whose symbols
# the binaries were checked against.
_deps=('expat' 'gcc-libs' 'libdisplay-info' 'libdrm' 'libelf' 'libglvnd' 'libunwind' 'libx11'
       'libxcb' 'libxext' 'libxfixes' 'libxrandr' 'libxshmfence' 'libxxf86vm' 'systemd-libs'
       'vulkan-icd-loader' 'wayland' 'xcb-util-keysyms' 'zlib' 'zstd')
_makedeps=('meson' 'ninja' 'cmake' 'python' 'python-mako' 'python-packaging' 'python-ply'
           'python-pycparser' 'python-yaml' 'llvm22' 'llvm22-libs' 'clang22' 'compiler-rt22'
           'glslang' 'wayland-protocols' 'xorgproto' 'vulkan-headers' 'binutils')
options=('strip' '!debug' '!lto')
_src=mesa-26.1.4
_prefix=/opt/mesa-m3
_native_src=mesa-hal200
_native_commit=78908f4d18af2274b5df08c4ad9d953c25980b53
_native_prefix=${_prefix}/25g83
_llvm=/usr/lib/llvm22
_slt=SPIRV-LLVM-Translator-0e67244861402a51b071414d7cb231a052b1ce03
_slt_headers=SPIRV-Headers-575b6512579ebde466ed3dfc04e413439d14d95d
_spvtools=SPIRV-Tools-vulkan-sdk-1.4.357.0
_spvtools_headers=SPIRV-Headers-vulkan-sdk-1.4.357.0
source=("mesa-m3-src-${_commit:0:11}.tar.zst"
        "mesa-m3-hal200-${_native_commit:0:12}.tar.zst"
        mesa-m3-profile.h mesa-m3-abi-check.c
        build-checks.sh late-load.c tls-pad.c queue-check.py
        llvm-project-22.1.8-libclc.tar.zst
        SPIRV-LLVM-Translator-0e67244.tar.gz
        SPIRV-Headers-575b651.tar.gz
        SPIRV-Tools-vulkan-sdk-1.4.357.0.tar.gz
        SPIRV-Headers-vulkan-sdk-1.4.357.0.tar.gz
        10-m3-asahi-zink.conf
        gpu-heat.c
        compute-check.c
        compute-check.comp
        mesa-m3-probe.c
        mesa-m3-session-env
        50-mesa-m3
        notices-gen.py
        mesa-m3-loadcheck.c
        needs-derive.py
        kernel-digest.py
        mesa-m3-user-setup
        user-setup.list
        72-mesa-m3-render-node.rules
        mesa-m3-session-confirm
        mesa-m3-session-confirm.service
        mesa-m3-wlcheck.c
        mesa-m3-system-check.c)
sha256sums=('7ed24969985dce91f089d34dbe1c55cbcb8c95765e3e5bc0f268d27fbead2222'
