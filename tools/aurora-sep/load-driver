#!/bin/sh
set -eu

keybag=/var/lib/aurora-sep-keybag.bin
refkey=/var/lib/aurora-sep-refkey.bin

# Seconds to wait for the enclave to seal and unseal a trusted key, then for
# /dev/sep-bio. On J700 the key store arrives around 43 s after boot, and the
# driver waits up to 90 s for it before it brings Touch ID up, so the first
# wait has to outlast that. Set either in the environment, for example with a
# drop-in for aurora-sep.service.
ready_timeout=${AURORA_SEP_READY_TIMEOUT:-120}
device_timeout=${AURORA_SEP_DEVICE_TIMEOUT:-60}

log() {
    echo "aurora-sep-load: $*" >&2
}

for budget in "$ready_timeout" "$device_timeout"; do
    case "$budget" in
        '' | *[!0-9]*)
            log "timeouts must be whole seconds, not '$budget'"
            exit 2
            ;;
    esac
done

# Seconds since boot. Unlike the wall clock it cannot jump when the time is
# first synchronised during boot.
uptime_s() {
    read -r up _ </proc/uptime
    echo "${up%%.*}"
}

# An SSH/sudo caller cannot change its parent's session keyring with
# `keyctl new_session`. Run the whole probe in a child keyring instead; the
# marker prevents re-exec recursion and the keyring dies with this process.
if [ "${AURORA_SEP_SESSION:-0}" != 1 ]; then
    exec keyctl session aurora-sep-load env AURORA_SEP_SESSION=1 "$0" "$@"
fi

# aurora-sep and aurora-touchid each own /usr/lib/modprobe.d/apple-sep.conf
# and conflict. Writing it here leaves an unowned file. A --read-only
# install hides that file with /etc/modprobe.d/apple-sep.conf.
# Rust parameters are registered with perm 0, so
# /sys/module/apple_sep/parameters never appears. An already-loaded module
# is not a failure: udev loads it on the M1 family and J700 before this
# service runs, and stopping here skips Touch ID activation and fingerprint
# restore (aurora-sep-ready Requires this unit). diag/xart is the running
# driver's own report of writes. AURORA_SEP_DIAG_XART overrides that file;
# "none" skips the hint.
module_dir=${AURORA_SEP_MODULE_DIR:-/sys/module/apple_sep}
already_loaded=0
if [ ! -d "$module_dir" ]; then
    modprobe apple_sep
else
    already_loaded=1
fi

# A module loaded read-only keeps those parameters until the next boot.
# Said only after the trusted-key wait fails: diag xart is also "disabled"
# while the iBoot container link is still missing, and that wait is long
# enough for the store to open when writes are actually on.
read_only_loaded_hint() {
    [ "$already_loaded" = 1 ] || return 0
    if [ -z "${AURORA_SEP_DIAG_XART+x}" ]; then
        diag=
        for f in /sys/bus/platform/devices/*.sep/diag/xart; do
            if [ -r "$f" ]; then
                diag=$f
                break
            fi
        done
    else
        diag=$AURORA_SEP_DIAG_XART
        if [ -z "$diag" ] || [ "$diag" = none ]; then
            return 0
        fi
    fi
    [ -n "$diag" ] && [ -r "$diag" ] || return 0
    read -r xart_state <"$diag" || return 0
    if [ "$xart_state" = disabled ]; then
        log "apple_sep was already loaded read-only (diag xart=disabled). The option file applies on the next boot; reboot before expecting writes."
    fi
}

run_dir=${AURORA_SEP_RUN_DIR:-/run}
work=$(mktemp -d "$run_dir/aurora-sep-load.XXXXXX")
cleanup() {
    case "$work" in
        "$run_dir"/aurora-sep-load.*) rm -rf -- "$work" ;;
    esac
}
trap cleanup EXIT HUP INT TERM

start=$(uptime_s)
deadline=$((start + ready_timeout))
verified=false
while :; do
    key_id=$(printf 'new 32' | keyctl padd trusted aurora-sep-check @s 2>/dev/null || true)
    if [ -n "$key_id" ]; then
        if keyctl pipe "$key_id" >"$work/sealed"; then
            { printf 'load '; tr -d '\n\r ' <"$work/sealed"; } >"$work/load"
            loaded_id=$(keyctl padd trusted aurora-sep-load-check @s <"$work/load" 2>/dev/null || true)
            if [ -n "$loaded_id" ]; then
                keyctl revoke "$loaded_id" >/dev/null 2>&1 || true
                verified=true
            fi
        fi
        keyctl revoke "$key_id" >/dev/null 2>&1 || true
    fi
    [ "$verified" = true ] && break
    [ "$(uptime_s)" -lt "$deadline" ] || break
    sleep 0.1
done

if [ "$verified" != true ]; then
    log "the enclave did not seal and unseal a trusted key within ${ready_timeout} s"
    read_only_loaded_hint
    exit 1
fi
log "trusted keys work after $(($(uptime_s) - start)) s"

if [ ! -s "$keybag" ] || [ ! -s "$refkey" ]; then
    log "$keybag or $refkey is missing or empty"
    exit 1
fi

deadline=$(($(uptime_s) + device_timeout))
while [ ! -c /dev/sep-bio ] && [ "$(uptime_s)" -lt "$deadline" ]; do
    sleep 0.1
done
if [ ! -c /dev/sep-bio ]; then
    log "/dev/sep-bio did not appear within ${device_timeout} s"
    exit 1
fi
log "/dev/sep-bio is ready after $(($(uptime_s) - start)) s"
