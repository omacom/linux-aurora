source=('aurora-touchid-setup'
        'extract-mesa-calibration'
        'apple-sep.service'
        'apple-sep.path'
        'apple-sep.conf'
        'fprintd-aurora.conf'
        'aurora-touchid.sleep'
        'wait-for-display'
        'sddm-wait-display.conf')
