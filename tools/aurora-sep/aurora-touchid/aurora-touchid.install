# An earlier --read-only install wrote /etc/modprobe.d/aurora-sep.conf.
# That name does not hide /usr/lib/modprobe.d/apple-sep.conf, so modprobe
# passes both option lines and the set-once parameters refuse to load.
# Rename it onto the name that hides the packaged file. If both exist,
# drop the old one.

_migrate_read_only_modprobe() {
  old=/etc/modprobe.d/aurora-sep.conf
  new=/etc/modprobe.d/apple-sep.conf
  [ -e "$old" ] || return 0
  if [ -e "$new" ]; then
    rm -f -- "$old"
  else
    mv -- "$old" "$new"
  fi
}

post_install() {
  _migrate_read_only_modprobe
}

post_upgrade() {
  _migrate_read_only_modprobe
}
