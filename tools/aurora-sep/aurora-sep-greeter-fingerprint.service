[Unit]
Description=Offer fingerprint at the GNOME login screen
Documentation=file:///usr/share/doc/aurora-sep/README.md
# Only prepares the login screen's shell, so it never waits for Touch ID: the
# enclave can take most of a minute, and the login screen must not. When
# Touch ID comes up after the login screen has asked for the reader,
# aurora-sep-greeter-refresh.service shows the login screen again.
Before=gdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/aurora-sep-greeter-fingerprint
ExecStop=/usr/local/sbin/aurora-sep-greeter-fingerprint stop

[Install]
WantedBy=gdm.service
Also=aurora-sep-greeter-refresh.service
