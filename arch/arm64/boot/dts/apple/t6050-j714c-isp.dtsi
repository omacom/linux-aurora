// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * J714c ISP: T6050's ISP17a (ASC version 0x110003), laid out and booted as
 * aurora's T6040 (M4 Pro/Max) one, at the same addresses: isp0 0x580000000,
 * dart-isp0 0x5828c0000/0x5828e0000/0x582900000 (+0xc000), the mailbox at
 * +0x2924000. T8140's mailbox offset, +0x2920000, stalls the bus here.
 * From the J714c ADT: IRQs [513 514 515 516 526] (513 carries the mailbox),
 * dart-isp0 IRQ 531, remap streams 1 6 7 10 11 -> 0, sensor-type 0x73.
 *
 * The ADT marks the ISP sub-domains no_ps, but pmgr1's slots run by device id
 * 8 bytes apart from ISP_SYS (218, +0x3a0): ISP_CPU 220 +0x3b0, ISP_FE 221
 * +0x3b8, DPRX 225 +0x3d8, ISP_SECURE 226 +0x3e0, ISP_BE 227 +0x3e8, ISP_CLR
 * 228 +0x3f0, with the ADT's parents. All reach active from the AP.
 *
 * iBoot loads the firmware's __TEXT and __DATA (isp0 segment-ranges) into its
 * 32 MiB main memory at 0x100_0000_0000; they end at 0x1fec000. The physical
 * addresses are those of iBoot mBoot-20457.60.65.0.1 (macOS 27.3 beta 1) and
 * move with it. No "isp" alias: the boot loader leaves this node as it is.
 *
 * The front camera is an IMX958 (sensor 0x958), as on the M4 Pro/Max.
 */

&{/reserved-memory} {
	isp_fw_text: isp-firmware-text@10001224000 {
		reg = <0x100 0x01224000 0x0 0xc1c000>;
		iommu-addresses = <&isp 0x100 0x0 0x0 0xc1c000>;
		no-map;
	};

	isp_fw_data: isp-firmware-data@10002930000 {
		reg = <0x100 0x02930000 0x0 0x13d0000>;
		iommu-addresses = <&isp 0x100 0xc1c000 0x0 0x13d0000>;
		no-map;
	};

	/* the firmware's main memory, the driver backs it above the data */
	isp_heap: isp-heap {
		iommu-addresses = <&isp 0x100 0x0 0x0 0x2000000>;
	};
};

&pmgr1 {
	ps_isp_cpu: power-controller@3b0 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x3b0 4>;
		label = "isp_cpu";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		power-domains = <&ps_isp_sys>;
	};

	ps_isp_fe: power-controller@3b8 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x3b8 4>;
		label = "isp_fe";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		power-domains = <&ps_isp_sys>;
	};

	ps_isp_dprx: power-controller@3d8 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x3d8 4>;
		label = "isp_dprx";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		power-domains = <&ps_isp_fe>;
	};

	ps_isp_secure: power-controller@3e0 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x3e0 4>;
		label = "isp_secure";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		power-domains = <&ps_isp_fe>;
	};

	ps_isp_be: power-controller@3e8 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x3e8 4>;
		label = "isp_be";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		power-domains = <&ps_isp_fe>;
	};

	ps_isp_clr: power-controller@3f0 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x3f0 4>;
		label = "isp_clr";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		power-domains = <&ps_isp_be>;
	};
};

&soc {
	isp_dart0: iommu@5828c0000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		/* ADT dart-isp0 reg[0] and reg[5], its address filter */
		reg = <0x5 0x828c0000 0x0 0xc000>, <0x5 0x828d0000 0x0 0x4000>;
		reg-names = "dart", "dapf";
		#iommu-cells = <1>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 531 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_isp_sys>;
		apple,remap-streams = <1 0>, <6 0>, <7 0>, <10 0>, <11 0>;
	};

	isp_dart1: iommu@5828e0000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x5 0x828e0000 0x0 0xc000>;
		#iommu-cells = <1>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 531 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_isp_sys>;
		apple,remap-streams = <1 0>, <6 0>, <7 0>, <10 0>, <11 0>;
	};

	isp_dart2: iommu@582900000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x5 0x82900000 0x0 0xc000>;
		#iommu-cells = <1>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 531 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_isp_sys>;
		apple,remap-streams = <1 0>, <6 0>, <7 0>, <10 0>, <11 0>;
	};

	/*
	 * As on T6040: "coproc" up to its control block; "mbox", "gpio" and
	 * "mbox2" are the interrupt words, the firmware handshake words and
	 * the doorbell of the mailbox at +0x2924000.
	 */
	isp: isp@580000000 {
		compatible = "apple,t6050-isp", "apple,isp";
		iommus = <&isp_dart0 0>, <&isp_dart1 0>, <&isp_dart2 0>;
		reg-names = "coproc", "mbox", "gpio", "mbox2", "wdt", "cil";
		reg = <0x5 0x80000000 0x0 0x1604000>,
		      <0x5 0x82924000 0x0 0x40>,
		      <0x5 0x829241d0 0x0 0x20>,
		      <0x5 0x82924464 0x0 0x10>,
		      <0x5 0xc3b50000 0x0 0x8000>,
		      <0x2 0xdc000234 0x0 0x4>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 513 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_isp_sys>, <&ps_isp_cpu>, <&ps_isp_fe>,
				<&ps_isp_dprx>, <&ps_isp_secure>, <&ps_isp_be>,
				<&ps_isp_clr>, <&ps_ispsens0>;
		memory-region = <&isp_fw_text>, <&isp_fw_data>, <&isp_heap>;
		memory-region-names = "text", "data", "heap";
		/* the shared memory window above the firmware's 32 MiB */
		apple,dart-vm-size = /bits/ 64 <0xde600000>;
		/* the ADT isp0 sensor-type */
		apple,platform-id = <0x73>;
		apple,temporal-filter = <1>;
		/* ADT isp0 cam-connections-scheme, as on the M4 Pro/Max J614/J616 */
		apple,cam-connections-scheme = <0x10>;
		/*
		 * The camera light: ADT eic cil-gpio-offset 141 in gpio0
		 * (0x2dc000000), cil-gpio-config 0x474002. Active high: driven
		 * low it is off even while the sensor streams (measured).
		 * "wdt" is the eic's mmio-wd-isp: frames pass only while it is fed,
		 * which the driver does only while the light is on.
		 */
		apple,cil-config = <0x474002>;
		apple,cil-active-high;

		/*
		 * The full IMX958 (firmware configuration 7, 3040x2880), cropped to
		 * the centre: inside the lens circle and about the field of view
		 * macOS shows. 1920x1080 and 1280x720 scale a 2400x1350 window;
		 * 2560x1440 is the centre 1:1.
		 */
		sensor-presets {
			/* 1920x1080 */
			preset0 {
				apple,config-index = <7>;
				apple,input-size = <3040 2880>;
				apple,output-size = <1920 1080>;
				apple,crop = <320 765 2400 1350>;
			};
			/* 1280x720 */
			preset1 {
				apple,config-index = <7>;
				apple,input-size = <3040 2880>;
				apple,output-size = <1280 720>;
				apple,crop = <320 765 2400 1350>;
			};
			/* 2560x1440 */
			preset2 {
				apple,config-index = <7>;
				apple,input-size = <3040 2880>;
				apple,output-size = <2560 1440>;
				apple,crop = <240 720 2560 1440>;
			};
		};
	};
};
