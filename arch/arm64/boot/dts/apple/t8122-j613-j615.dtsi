/*
 * Apple MacBook Air (13-inch and 15-inch, M3, 2024)
 *
 * This file contains the parts common to J613 and J615 devices with t8122.
 *
 * target-type: J613, J615
 *
 * Copyright The Asahi Linux Contributors
 */

#include "t8122-usbpd-spmi.dtsi"
#include "t8122-jxxx.dtsi"
#include <dt-bindings/leds/common.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	chassis-type = "laptop";

	aliases {
		dcpext = &dcpext;
		keyboard = &keyboard;
		sep = &sep;
	};

	led-controller {
		compatible = "pwm-leds";
		led-0 {
			pwms = <&fpwm1 0 40000>;
			label = "kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
			default-state = "keep";
		};
	};
};

&aop_mbox {
	status = "okay";
};

&aop_dart {
	status = "okay";
};

&aop_admac {
	status = "okay";
};

&aop {
	status = "okay";
};

&aop_audio {
	apple,machine-kind = "MacBook Air";
};

&i2c3 {
	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_nub 17 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl_ap 173 IRQ_TYPE_LEVEL_LOW>;
		sound-name-prefix = "Jack";
	};
};

&fpwm1 {
	status = "okay";
};

&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	apple,afe-reset-gpios = <&smc_gpio 8 GPIO_ACTIVE_LOW>;
	apple,stm-reset-gpios = <&smc_gpio 24 GPIO_ACTIVE_LOW>;

	mtp_mt: multi-touch {
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <0>;
	};

	stm {
	};

	actuator {
	};

	tp_accel {
	};
};

#include "isp-imx558-cfg0.dtsi"

&isp {
	apple,platform-id = <18>;
	apple,temporal-filter = <1>;
};

/* Touch ID; its data-ready line (AP GPIO 199) is left out, so it polls. */
&spi2 {
	status = "okay";
};

&mesa {
	status = "okay";
	enable-gpios = <&pinctrl_nub 29 GPIO_ACTIVE_HIGH>;
	spi-cs-setup-delay-ns = <20>;
	spi-cs-hold-delay-ns = <20>;
};

#include "hwmon-laptop.dtsi"

/*
 * One external display on either USB-C port: dcpext is crossbar state 2 of
 * each ATC and its DPTX target is the ATC index. The display gate enables it
 * and the routes once the boot loader has readied its firmware.
 */
&dcpext {
	apple,connector-type = "USB-C";
	phys = <&atcphy0 PHY_TYPE_DP>, <&atcphy1 PHY_TYPE_DP>;
	phy-names = "typec0", "typec1";
	mux-controls = <&atcphy0_xbar 0>, <&atcphy1_xbar 0>;
	mux-control-names = "typec0", "typec1";
	apple,typec-mux-indices = <2 2>;
	apple,typec-dptx-phys = <0 1>;
	/* RTKit quirks of AsahiLinux/linux#607 (syslog/ioreport acks, kdebug). */
	apple,sync-syslog-ack;

	typec-routes {
		#address-cells = <1>;
		#size-cells = <0>;

		route@0 {
			reg = <0>;
			mode-switch;
			status = "disabled";

			port {
				dcpext_typec0: endpoint {
					remote-endpoint = <&typec0_dcpext>;
				};
			};
		};

		route@1 {
			reg = <1>;
			mode-switch;
			status = "disabled";

			port {
				dcpext_typec1: endpoint {
					remote-endpoint = <&typec1_dcpext>;
				};
			};
		};
	};
};

&typec0 {
	ports {
		port@3 {
			reg = <3>;

			typec0_dcpext: endpoint {
				remote-endpoint = <&dcpext_typec0>;
			};
		};
	};
};

&typec1 {
	ports {
		port@3 {
			reg = <3>;

			typec1_dcpext: endpoint {
				remote-endpoint = <&dcpext_typec1>;
			};
		};
	};
};

/ {
	/*
	 * Fanless, same die and the same six CPU die sensors on both: every
	 * die sensor throttles both clusters, E weighted 3:1 and capped at
	 * state 3. Trips as on the J700; sustainable-power from J613 and J615
	 * load tests.
	 */
	thermal-zones {
		cpu-e0-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 0>;	/* Te05 */
			sustainable-power = <6000>;

			trips {
				cpu_e0_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_e0_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_e0_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_e0_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-e1-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 1>;	/* Te0P */
			sustainable-power = <6000>;

			trips {
				cpu_e1_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_e1_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_e1_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_e1_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p0-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 2>;	/* Tp05 */
			sustainable-power = <6000>;

			trips {
				cpu_p0_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p0_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p0_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p0_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p1-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 3>;	/* Tp0L */
			sustainable-power = <6000>;

			trips {
				cpu_p1_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p1_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p1_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p1_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p2-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 4>;	/* Tp0b */
			sustainable-power = <6000>;

			trips {
				cpu_p2_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p2_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p2_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p2_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p3-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 5>;	/* Tp0r */
			sustainable-power = <6000>;

			trips {
				cpu_p3_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p3_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p3_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p3_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};
	};
};
