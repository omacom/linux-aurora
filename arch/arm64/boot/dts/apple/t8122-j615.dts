/dts-v1/;

#include "t8122.dtsi"
#include "t8122-usbpd-spmi.dtsi"
#include "t8122-jxxx.dtsi"
#include <dt-bindings/leds/common.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "apple,j615", "apple,t8122", "apple,arm-platform";
	model = "Apple MacBook Air (15-inch, M3, 2024)";

	aliases {
		sep = &sep;
	};

	led-controller {
		compatible = "pwm-leds";
		led-0 {
			pwms = <&fpwm1 0 40000>;
			label = "kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
			default-state = "keep";
		};
	};

	/*
	 * The J615 is fanless like the J613, on the same die with the same
	 * six CPU die sensors, so it takes the J613's zones unchanged: one
	 * zone per sensor, each throttling both clusters through the power
	 * allocator, E cluster weighted three to one and capped at cooling
	 * state 3 (2004 MHz); switch-on 58 C, control 95 C, critical 110 C.
	 *
	 * Without zones nothing limits the CPU: eight busy cores passed 105 C
	 * in 150 s, still rising, and a -j8 kernel build held 110-114.6 C for
	 * 22 minutes. sustainable-power was checked on a J615: with 6 W eight
	 * busy cores peaked at 87.7 C with the P cores at 3.1-3.6 GHz, and a
	 * 20 minute -j8 kernel build held a level 91-92 C at 2.9 GHz (peak
	 * 97.2 C, 6 of 545 samples at or above 95 C). 8 W peaked at 96.3 C
	 * under the eight-core load with no gain in P-core frequency.
	 */
	thermal-zones {
		cpu-e0-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 0>;	/* Te05 */
			sustainable-power = <6000>;

			trips {
				cpu_e0_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_e0_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_e0_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_e0_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-e1-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 1>;	/* Te0P */
			sustainable-power = <6000>;

			trips {
				cpu_e1_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_e1_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_e1_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_e1_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p0-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 2>;	/* Tp05 */
			sustainable-power = <6000>;

			trips {
				cpu_p0_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p0_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p0_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p0_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p1-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 3>;	/* Tp0L */
			sustainable-power = <6000>;

			trips {
				cpu_p1_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p1_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p1_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p1_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p2-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 4>;	/* Tp0b */
			sustainable-power = <6000>;

			trips {
				cpu_p2_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p2_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p2_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p2_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p3-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 5>;	/* Tp0r */
			sustainable-power = <6000>;

			trips {
				cpu_p3_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p3_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p3_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p3_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};
	};
};

&dcp {
	panel: panel {
		compatible = "apple,panel-j615", "apple,panel";
		/* 2880x1864 at 224 ppi; 64 notch rows above the desktop. */
		width-mm = <327>;
		height-mm = <211>;
		adj-height-mm = <204>;
		apple,max-brightness = <500>;
	};
};

&framebuffer0 {
	panel = <&panel>;
	post-init-providers = <&panel>;
};

&aop_mbox {
	status = "okay";
};

&aop_dart {
	status = "okay";
};

&aop_admac {
	status = "okay";
};

&aop {
	status = "okay";
};

&aop_audio {
	apple,chassis-name = "J615";
	apple,machine-kind = "MacBook Air";
};

&wifi0 {
	brcm,board-type = "apple,tuzla";
};

&bluetooth0 {
	brcm,board-type = "apple,tuzla";
};

&i2c1 {
	speaker_left_woof1: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		shutdown-gpios = <&pinctrl_ap 13 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 1";
		interrupts-extended = <&pinctrl_ap 12 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <0>;
		ti,vmon-slot-no = <2>;
	};

	speaker_left_tweet: codec@39 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x39>;
		shutdown-gpios = <&pinctrl_ap 13 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Tweeter";
		interrupts-extended = <&pinctrl_ap 12 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <8>;
		ti,vmon-slot-no = <10>;
	};

	speaker_left_woof2: codec@3a {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3a>;
		shutdown-gpios = <&pinctrl_ap 13 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 2";
		interrupts-extended = <&pinctrl_ap 12 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <16>;
		ti,vmon-slot-no = <18>;
	};
};

&i2c3 {
	speaker_right_woof1: codec@3b {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3b>;
		shutdown-gpios = <&pinctrl_ap 13 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 1";
		interrupts-extended = <&pinctrl_ap 12 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <4>;
		ti,vmon-slot-no = <6>;
	};

	speaker_right_tweet: codec@3c {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3c>;
		shutdown-gpios = <&pinctrl_ap 13 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Tweeter";
		interrupts-extended = <&pinctrl_ap 12 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <12>;
		ti,vmon-slot-no = <14>;
	};

	speaker_right_woof2: codec@3d {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3d>;
		shutdown-gpios = <&pinctrl_ap 13 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 2";
		interrupts-extended = <&pinctrl_ap 12 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <20>;
		ti,vmon-slot-no = <22>;
	};

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_nub 17 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl_ap 173 IRQ_TYPE_LEVEL_LOW>;
		sound-name-prefix = "Jack";
	};
};

/ {
	sound {
		compatible = "apple,j615-macaudio", "apple,j415-macaudio", "apple,macaudio";
		model = "MacBook Air J615";

		dai-link@0 {
			link-name = "Speakers";
			dai-tdm-idle-mode-0 = "zero";
			dai-tdm-idle-mode-3 = "zero";
			dai-tdm-slot-tx-idle-mask-0 = <0x0f0f0f>;
			dai-tdm-slot-tx-idle-mask-3 = <0xf0f0f0>;

			cpu {
				sound-dai = <&mca 0>, <&mca 1>;
			};
			codec {
				sound-dai = <&speaker_left_woof1>, <&speaker_left_tweet>, <&speaker_left_woof2>,
					    <&speaker_right_woof1>, <&speaker_right_tweet>, <&speaker_right_woof2>;
			};
		};

		dai-link@1 {
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&mca 2>;
			};
			codec {
				sound-dai = <&jack_codec>;
			};
		};
	};
};

&fpwm1 {
	status = "okay";
};

&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	apple,afe-reset-gpios = <&smc_gpio 8 GPIO_ACTIVE_LOW>;
	apple,stm-reset-gpios = <&smc_gpio 24 GPIO_ACTIVE_LOW>;

	multi-touch {
		firmware-name = "apple/tpmtfw-j615.bin";
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <0>;
	};

	stm {
	};

	actuator {
	};

	tp_accel {
	};
};

#include "isp-imx558-cfg0.dtsi"

&isp {
	apple,platform-id = <18>;
	apple,temporal-filter = <1>;
};

/*
 * Mesa fingerprint sensor on spi2 (J615 ADT /arm-io/spi2/mesa): power on
 * NUB GPIO 29, active high. The data-ready line (AP GPIO 199) is left out,
 * so the driver polls until its trigger is confirmed. Native chip select only.
 */
&spi2 {
	status = "okay";
};

&mesa {
	status = "okay";
	enable-gpios = <&pinctrl_nub 29 GPIO_ACTIVE_HIGH>;
	spi-cs-setup-delay-ns = <20>;
	spi-cs-hold-delay-ns = <20>;
	/* Per-device factory data from this Mac's own iBoot system container. */
	firmware-name = "apple/mesacal-j615.bin";
};

#include "hwmon-laptop.dtsi"
