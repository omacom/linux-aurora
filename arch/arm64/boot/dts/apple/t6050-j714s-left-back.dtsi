&apciec0_port {
	apple,tunable = <0x140 0x1 0x1>,
			<0x2a0 0x7e 0xa>;
};

/*
 * The producer's all-or-nothing ATC0 activation group. Shared AUSS, AOP GPIO
 * and CIO reset providers stay enabled for the existing ports. GPIO 77 stays
 * reserved until the same handoff transaction releases only that pin.
 */

/ {
	firmware {
		atc0-handoff {
			compatible = "apple,atc-handoff";
			apple,phy = <&atc0_phy>;
			apple,devices = <&ps_atc0_common>,
				<&ps_atc0_usb_aon>,
				<&ps_atc0_usb>,
				<&ps_atc0_phymxwrap>,
				<&ps_atc0_cio>,
				<&ps_atc0_cio_pcie>,
				<&ps_atc0_cio_usb>,
				<&ps_atc0_cio_auss>,
				<&ps_atc0_pcie>,
				<&ps_atc0_common_dp_0>,
				<&ps_atc0_common_dp_1>,
				<&ps_atc0_common_dp_2>,
				<&ps_atc0_common_dp_3>,
				<&atc0_phy_mbox>,
				<&atc0_phy>,
				<&usb0_dart>,
				<&usb0_dart1>,
				<&usb_drd0>,
				<&hpm0>,
				<&acio0_mbox>,
				<&acio0>,
				<&acio0_dart>,
				<&acio0_nhi>,
				<&acio0_pcie_tunnel>,
				<&apciec0_dart>,
				<&apciec0>,
				<&atc0_dpxbar>;
		};
	};
};
