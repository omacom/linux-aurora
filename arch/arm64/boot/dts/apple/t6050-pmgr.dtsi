// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * PMGR Power domains for Apple T6050 "M5 Max" SoC
 *
 * Generated from the J714c ADT with pmgr_adt2dt.py, then edited by hand.
 * Regenerating loses the following:
 * - the CPU core and cluster domains are left out, as in every other
 *   pmgr file;
 * - parent references to register-less (no_ps) ADT domains point at the
 *   nearest real ancestor or are dropped;
 * - apple,always-on is removed from the 25 domains the boot firmware
 *   leaves off (b2b fabric, nub SPMI, afr) and added to the core set
 *   aic, disp_sys, disp_fe, uart_p, spi_p, ans as in t8132-pmgr.dtsi;
 * - apple,firmware-owned marks disp_cpu, dispext0-3_cpu (writing them
 *   raises an SError) and smc_i2cm0-5 (enabling auto-PM on one or more
 *   of them resets the machine a few seconds into the boot).
 *
 * Copyright The Asahi Linux Contributors
 */

&pmgr0 {
	ps_aic: power-controller@108 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x108 4>;
		label = "aic";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		apple,always-on;
	};

	ps_pmc: power-controller@110 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x110 4>;
		label = "pmc";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		apple,always-on;
	};

	ps_pms_c1ppt: power-controller@118 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x118 4>;
		label = "pms_c1ppt";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		apple,always-on;
	};

	ps_soc_dpe: power-controller@120 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x120 4>;
		label = "soc_dpe";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		apple,always-on;
	};

	ps_pmp: power-controller@128 {
