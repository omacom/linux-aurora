		label = "dispext2_sys";
		#power-domain-cells = <0>;
		power-domains = <&ps_fab4_soc>;
		#reset-cells = <0>;
	};

	ps_dispext3_sys: power-controller@228 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x228 4>;
		label = "dispext3_sys";
		#power-domain-cells = <0>;
