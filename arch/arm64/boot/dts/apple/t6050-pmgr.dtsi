	ps_b2bc_afc_1: power-controller@178 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x178 4>;
		label = "b2bc_afc_1";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		apple,always-on;
	};

	ps_b2bc_afc_1_dfx: power-controller@180 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x180 4>;
		label = "b2bc_afc_1_dfx";
		#power-domain-cells = <0>;
		power-domains = <&ps_b2bc_afc_1>;
		#reset-cells = <0>;
	};

	ps_fab4_soc: power-controller@1e8 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x1e8 4>;
		label = "fab4_soc";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		apple,always-on;
	};

	ps_fab5_soc: power-controller@1f0 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x1f0 4>;
		label = "fab5_soc";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		apple,always-on;
	};

	ps_dispext0_sys: power-controller@200 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x200 4>;
		label = "dispext0_sys";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
	};

	ps_atc0_common: power-controller@208 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
