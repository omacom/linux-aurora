		label = "dispext1_adma";
		#power-domain-cells = <0>;
		power-domains = <&ps_dispext1_sys>;
		#reset-cells = <0>;
	};

	ps_dispext1_cpu: power-controller@2e0 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x2e0 4>;
		label = "dispext1_cpu";
		#power-domain-cells = <0>;
		power-domains = <&ps_dispext1_fe>;
		#reset-cells = <0>;
		/* The display coprocessor owns this state; writing it faults (SError). */
		apple,firmware-owned;
	};

	ps_atc2_cio: power-controller@2e8 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x2e8 4>;
		label = "atc2_cio";
		#power-domain-cells = <0>;
		power-domains = <&ps_atc2_common>;
		#reset-cells = <0>;
		apple,firmware-owned;
	};

	ps_atc2_pcie: power-controller@2f0 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x2f0 4>;
		label = "atc2_pcie";
		#power-domain-cells = <0>;
		power-domains = <&ps_atc2_common>;
		#reset-cells = <0>;
	};

	ps_atc3_cio: power-controller@2f8 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x2f8 4>;
		label = "atc3_cio";
		#power-domain-cells = <0>;
		power-domains = <&ps_atc3_common>;
		#reset-cells = <0>;
		apple,firmware-owned;
	};

	ps_atc3_pcie: power-controller@300 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x300 4>;
		label = "atc3_pcie";
		#power-domain-cells = <0>;
		power-domains = <&ps_atc3_common>;
		#reset-cells = <0>;
	};

	ps_atc0_cio_pcie: power-controller@338 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x338 4>;
		label = "atc0_cio_pcie";
		#power-domain-cells = <0>;
