		power-domains = <&ps_dispext0_sys>;
		#reset-cells = <0>;
	};

	ps_dispext0_adma: power-controller@270 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x270 4>;
		label = "dispext0_adma";
		#power-domain-cells = <0>;
		power-domains = <&ps_dispext0_sys>;
		#reset-cells = <0>;
	};

	ps_dispext0_cpu: power-controller@278 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x278 4>;
		label = "dispext0_cpu";
		#power-domain-cells = <0>;
		power-domains = <&ps_dispext0_fe>;
		#reset-cells = <0>;
		/* The display coprocessor owns this state; writing it faults (SError). */
		apple,firmware-owned;
	};

/*
 * atc0-3_cio and atc3_common are left to the firmware for now: the kernel's
 * boot-time power-on of these domains (J714c) breaks the USB 2.0
 * host on the parked Type-C PHY (the xHCI reset never completes). USB4 needs
 * them driven in sequence with the PHY, by the PHY driver, later.
 */
	ps_atc0_cio: power-controller@280 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x280 4>;
		label = "atc0_cio";
		#power-domain-cells = <0>;
		power-domains = <&ps_atc0_common>;
		#reset-cells = <0>;
		apple,firmware-owned;
	};

	ps_atc0_pcie: power-controller@288 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x288 4>;
		label = "atc0_pcie";
		#power-domain-cells = <0>;
		power-domains = <&ps_atc0_common>;
		#reset-cells = <0>;
	};

	ps_atc1_cio: power-controller@290 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x290 4>;
		label = "atc1_cio";
		#power-domain-cells = <0>;
		power-domains = <&ps_atc1_common>;
		#reset-cells = <0>;
		apple,firmware-owned;
	};

	ps_atc1_pcie: power-controller@298 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x298 4>;
		label = "atc1_pcie";
		#power-domain-cells = <0>;
		power-domains = <&ps_atc1_common>;
		#reset-cells = <0>;
	};

	ps_dispext2_fe: power-controller@2a0 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x2a0 4>;
		label = "dispext2_fe";
		#power-domain-cells = <0>;
		power-domains = <&ps_dispext2_sys>;
		#reset-cells = <0>;
	};

	ps_dispext2_adma: power-controller@2a8 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x2a8 4>;
		label = "dispext2_adma";
		#power-domain-cells = <0>;
		power-domains = <&ps_dispext2_sys>;
		#reset-cells = <0>;
	};

