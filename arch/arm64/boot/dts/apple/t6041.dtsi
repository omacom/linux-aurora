	/delete-property/ opp-microwatt;
};

&{/opp-table-e/opp06} {
	/delete-property/ opp-microwatt;
};

&{/opp-table-e/opp07} {
	/delete-property/ opp-microwatt;
};

&ps_avd_sys {
	/delete-property/ power-domains;
};

&ps_atc0_common {
	/delete-property/ power-domains;
};

&ps_atc1_common {
	/delete-property/ power-domains;
};

&ps_atc2_common {
	/delete-property/ power-domains;
};

&ps_atc3_common {
	/delete-property/ power-domains;
};

/* FAB4_SOC and FAB5_SOC are critical, on from iBoot and not described here. */
&ps_ane_sys {
	/delete-property/ power-domains;
};

&ps_pmp {
	/delete-property/ power-domains;
};

&ps_pms_sram {
	/delete-property/ power-domains;
};

&serial0 {
	/delete-property/ power-domains;
	/delete-property/ status;
};

/delete-node/ &gpu;
/delete-node/ &gfx_mbox;
/delete-node/ &opp_p0;
/delete-node/ &opp_p1;

/ {
	cpus {
		cpu-map {
			cluster1 { core5 { cpu = <&cpu_p05>; }; };
			cluster2 { core5 { cpu = <&cpu_p15>; }; };
		};
		cpu_p05: cpu@10105 {
			compatible = "apple,brava-p";
			device_type = "cpu";
			reg = <0x0 0x10105>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_p0>;
			operating-points-v2 = <&opp_p0>;
			capacity-dmips-mhz = <1024>;
			performance-domains = <&cpufreq_p0>;
			#cooling-cells = <2>;
		};
		cpu_p15: cpu@10205 {
			compatible = "apple,brava-p";
			device_type = "cpu";
			reg = <0x0 0x10205>;
			enable-method = "spin-table";
			cpu-release-addr = <0 0>;
			next-level-cache = <&l2_cache_p1>;
			operating-points-v2 = <&opp_p1>;
			capacity-dmips-mhz = <1024>;
			performance-domains = <&cpufreq_p1>;
			#cooling-cells = <2>;
		};
	};

	opp_p0: opp-table-p0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp01 {
			opp-hz = /bits/ 64 <1260000000>;
			opp-level = <1>;
			clock-latency-ns = <7200>;
		};
		opp02 {
			opp-hz = /bits/ 64 <1512000000>;
			opp-level = <2>;
			clock-latency-ns = <19000>;
		};
		opp03 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-level = <3>;
			clock-latency-ns = <20000>;
		};
		opp04 {
			opp-hz = /bits/ 64 <2088000000>;
			opp-level = <4>;
			clock-latency-ns = <22000>;
		};
		opp05 {
			opp-hz = /bits/ 64 <2352000000>;
			opp-level = <5>;
			clock-latency-ns = <30000>;
		};
		opp06 {
			opp-hz = /bits/ 64 <2616000000>;
			opp-level = <6>;
			clock-latency-ns = <34000>;
		};
		opp07 {
			opp-hz = /bits/ 64 <2868000000>;
			opp-level = <7>;
			clock-latency-ns = <37000>;
		};
		opp08 {
			opp-hz = /bits/ 64 <3096000000>;
			opp-level = <8>;
			clock-latency-ns = <38000>;
		};
		opp09 {
			opp-hz = /bits/ 64 <3300000000>;
			opp-level = <9>;
			clock-latency-ns = <40000>;
		};
		opp10 {
			opp-hz = /bits/ 64 <3468000000>;
			opp-level = <10>;
			clock-latency-ns = <41000>;
		};
		opp11 {
			opp-hz = /bits/ 64 <3624000000>;
			opp-level = <11>;
			clock-latency-ns = <43000>;
		};
		opp12 {
			opp-hz = /bits/ 64 <3756000000>;
			opp-level = <12>;
			clock-latency-ns = <44000>;
		};
		opp13 {
			opp-hz = /bits/ 64 <3828000000>;
			opp-level = <13>;
			clock-latency-ns = <45000>;
		};
		opp14 {
			opp-hz = /bits/ 64 <3888000000>;
			opp-level = <14>;
			clock-latency-ns = <46000>;
		};
		opp15 {
			opp-hz = /bits/ 64 <3948000000>;
			opp-level = <15>;
			clock-latency-ns = <47000>;
		};
		opp16 {
			opp-hz = /bits/ 64 <3996000000>;
			opp-level = <16>;
			clock-latency-ns = <48000>;
		};
		opp17 {
			opp-hz = /bits/ 64 <4044000000>;
			opp-level = <17>;
			clock-latency-ns = <49000>;
		};
		opp18 {
			opp-hz = /bits/ 64 <4104000000>;
			opp-level = <18>;
			clock-latency-ns = <50000>;
		};
		opp19 {
			opp-hz = /bits/ 64 <4416000000>;
			opp-level = <19>;
			clock-latency-ns = <55000>;
			turbo-mode;
		};
		opp20 {
			opp-hz = /bits/ 64 <4512000000>;
			opp-level = <20>;
			clock-latency-ns = <56000>;
			turbo-mode;
		};
	};

	opp_p1: opp-table-p1 {
		compatible = "operating-points-v2";
		opp-shared;

		opp01 {
			opp-hz = /bits/ 64 <1260000000>;
			opp-level = <1>;
			clock-latency-ns = <7200>;
		};
		opp02 {
			opp-hz = /bits/ 64 <1512000000>;
			opp-level = <2>;
			clock-latency-ns = <19000>;
		};
		opp03 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-level = <3>;
			clock-latency-ns = <20000>;
		};
		opp04 {
			opp-hz = /bits/ 64 <2088000000>;
			opp-level = <4>;
			clock-latency-ns = <22000>;
		};
		opp05 {
			opp-hz = /bits/ 64 <2352000000>;
			opp-level = <5>;
			clock-latency-ns = <30000>;
		};
		opp06 {
			opp-hz = /bits/ 64 <2616000000>;
			opp-level = <6>;
			clock-latency-ns = <34000>;
		};
		opp07 {
			opp-hz = /bits/ 64 <2868000000>;
			opp-level = <7>;
			clock-latency-ns = <37000>;
		};
		opp08 {
			opp-hz = /bits/ 64 <3096000000>;
			opp-level = <8>;
			clock-latency-ns = <38000>;
		};
		opp09 {
			opp-hz = /bits/ 64 <3300000000>;
			opp-level = <9>;
			clock-latency-ns = <40000>;
		};
		opp10 {
			opp-hz = /bits/ 64 <3468000000>;
			opp-level = <10>;
			clock-latency-ns = <41000>;
		};
		opp11 {
			opp-hz = /bits/ 64 <3624000000>;
			opp-level = <11>;
			clock-latency-ns = <43000>;
		};
		opp12 {
			opp-hz = /bits/ 64 <3756000000>;
			opp-level = <12>;
			clock-latency-ns = <44000>;
		};
		opp13 {
			opp-hz = /bits/ 64 <3828000000>;
			opp-level = <13>;
			clock-latency-ns = <45000>;
		};
		opp14 {
			opp-hz = /bits/ 64 <3888000000>;
			opp-level = <14>;
			clock-latency-ns = <46000>;
		};
		opp15 {
			opp-hz = /bits/ 64 <3948000000>;
			opp-level = <15>;
			clock-latency-ns = <47000>;
		};
		opp16 {
			opp-hz = /bits/ 64 <3996000000>;
			opp-level = <16>;
			clock-latency-ns = <48000>;
		};
		opp17 {
			opp-hz = /bits/ 64 <4044000000>;
			opp-level = <17>;
			clock-latency-ns = <49000>;
		};
		opp18 {
			opp-hz = /bits/ 64 <4104000000>;
			opp-level = <18>;
			clock-latency-ns = <50000>;
		};
		opp19 {
			opp-hz = /bits/ 64 <4416000000>;
			opp-level = <19>;
			clock-latency-ns = <55000>;
			turbo-mode;
		};
		opp20 {
			opp-hz = /bits/ 64 <4512000000>;
			opp-level = <20>;
			clock-latency-ns = <56000>;
			turbo-mode;
		};
	};

};

&cpu_p00 {
	enable-method = "spin-table";
	cpu-release-addr = <0 0>;
};

&aic {
	reg = <0x5 0x02400000 0x0 0x1cc000>,
	      <0x5 0x02440000 0x0 0x4>;
};

&smc {
	reg = <0x5 0x0c600000 0x0 0x4000>,
	      <0x5 0x0de00000 0x0 0x170000>;
};

&pmc {
	/delete-property/ apple,pmp;
	apple,static-voters = <1 3>;
};

/ {
	gpu: gpu@288000000 {
		compatible = "apple,agx-t6041";
		reg = <0x2 0x8a600000 0x0 0x88000>,
		      <0x2 0x88000000 0x0 0x3758000>;
		reg-names = "asc", "sgx";
		mboxes = <&gfx_mbox>;
		power-domains = <&ps_gfx>;
		status = "disabled";
	};

	gfx_mbox: mailbox@28a600000 {
		compatible = "apple,t6040-ascwrap-v6";
		reg = <0x2 0x8a600000 0x0 0x88000>,
		      <0x2 0x8a050000 0x0 0x8>;
		reg-names = "wrapper", "iop-vbar";
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1501 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 1504 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "send-empty", "recv-not-empty";
		apple,firmware-role = "GFX";
		power-domains = <&ps_gfx>;
		#mbox-cells = <0>;
		status = "disabled";
	};
};

&ps_afr {
	apple,always-on;
	apple,no-auto-pm;
};

&ps_gfx {
	apple,always-on;
	apple,no-auto-pm;
};
