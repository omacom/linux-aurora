};

&avd {
	compatible = "apple,t6041-max-avd", "apple,t6041-avd", "apple,t8132-avd";
	power-domains = <&ps_avd_sys>;
	/delete-property/ power-domain-names;
};

&nub_spmi0 {
	/delete-property/ interrupt-controller;
	/delete-property/ #interrupt-cells;
	/delete-property/ interrupt-parent;
	/delete-property/ interrupts;
};

&usb_drd0_dart_0 {
	/delete-property/ apple,dma-range;
};

&usb_drd0_dart_1 {
	/delete-property/ apple,dma-range;
};

&usb_drd1_dart_0 {
	/delete-property/ apple,dma-range;
};

&usb_drd1_dart_1 {
	/delete-property/ apple,dma-range;
};

&usb_drd2_dart_0 {
	/delete-property/ apple,dma-range;
};

&usb_drd2_dart_1 {
	/delete-property/ apple,dma-range;
};

&mtp_dart {
	/delete-property/ apple,dma-range;
};

&{/opp-table-e/opp01} {
	/delete-property/ opp-microwatt;
};

&{/opp-table-e/opp02} {
	/delete-property/ opp-microwatt;
};

