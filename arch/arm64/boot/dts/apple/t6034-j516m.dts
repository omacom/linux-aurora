// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * MacBook Pro (16-inch, M3 Max, 14 CPU cores, Nov 2023)
 *
 * target-type: J516m
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t6034.dtsi"
#include "t6034-dcp.dtsi"
#include "t603x-j514-j516.dtsi"

/ {
	compatible = "apple,j516m", "apple,t6034", "apple,arm-platform";
	model = "Apple MacBook Pro (16-inch, M3 Max, 14 CPU cores, Nov 2023)";
};

&mtp_mt {
	firmware-name = "apple/tpmtfw-j516m.bin";
};

&wifi0 {
	brcm,board-type = "apple,jura";
};

&bluetooth0 {
	brcm,board-type = "apple,jura";
};

/* J516 panel dimensions, as on the J516C (same 16-inch chassis and panel). */
&dcp {
	panel {
		compatible = "apple,panel-j516", "apple,panel-mini-led", "apple,panel";
		width-mm = <346>;
		height-mm = <223>;
		adj-height-mm = <216>;
		apple,max-brightness = <500>;
	};
};

&aop_audio {
	apple,chassis-name = "J516";
	apple,machine-kind = "MacBook Pro";
};

&sound {
	compatible = "apple,j516-macaudio", "apple,j316-macaudio", "apple,macaudio";
	model = "MacBook Pro J516";
};
