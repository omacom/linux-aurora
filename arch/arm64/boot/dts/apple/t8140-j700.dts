		apple,key-id = "Te0T";
		label = "SMC Te0T";
	};

	temperature-Tex0 {
		apple,key-id = "Tex0";
		label = "SMC Tex0";
	};

	temperature-Tex1 {
		apple,key-id = "Tex1";
		label = "SMC Tex1";
	};

	temperature-Tex2 {
		apple,key-id = "Tex2";
		label = "SMC Tex2";
	};

	temperature-Tex3 {
		apple,key-id = "Tex3";
		label = "SMC Tex3";
	};

	temperature-Tp00 {
		apple,key-id = "Tp00";
		label = "SMC Tp00";
	};

	temperature-Tp02 {
		apple,key-id = "Tp02";
		label = "SMC Tp02";
	};

	temperature-Tp04 {
		apple,key-id = "Tp04";
		label = "SMC Tp04";
	};

	temperature-Tp06 {
		apple,key-id = "Tp06";
		label = "SMC Tp06";
	};

	temperature-Tp08 {
		apple,key-id = "Tp08";
		label = "SMC Tp08";
	};

	temperature-Tp0A {
		apple,key-id = "Tp0A";
		label = "SMC Tp0A";
	};

	temperature-Tp0C {
		apple,key-id = "Tp0C";
		label = "SMC Tp0C";
	};

	temperature-Tp0E {
		apple,key-id = "Tp0E";
		label = "SMC Tp0E";
	};

	temperature-Tp0l {
		apple,key-id = "Tp0l";
		label = "SMC Tp0l";
