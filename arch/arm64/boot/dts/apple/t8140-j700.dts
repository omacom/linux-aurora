&smc_mbox {
	status = "okay";
};

&ans_mbox {
	status = "okay";
};

&sart {
	status = "okay";
};

&nvme {
	status = "okay";
};

&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	apple,no-stm;
	/* SMC pcIO output 19; level 1 asserts the reset */
	apple,afe-reset-gpios = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;

	multi-touch {
		compatible = "apple,j700-multitouch";
		firmware-name = "apple/tpmtfw-j700.bin";
		apple,power-method = <2>;
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <0>;
	};
};

/* USB PD controllers, on the nub SPMI A0 bus */
&nub_spmi_a0 {
	status = "okay";

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;
		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
			     <39 IRQ_TYPE_EDGE_RISING>,
			     <43 IRQ_TYPE_EDGE_RISING>,
			     <45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-front";
			power-role = "dual";
			data-role = "host";

			/* USB 2.0 only, through the fixed hub */
			port {
				typec1_connector_hs: endpoint {
					remote-endpoint = <&hub_front>;
				};
			};
		};
	};

	hpm0: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;
		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
			     <13 IRQ_TYPE_EDGE_RISING>,
			     <17 IRQ_TYPE_EDGE_RISING>,
			     <19 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-back";
			power-role = "dual";
			data-role = "host";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					typec0_connector_hs: endpoint {
						remote-endpoint = <&hub_rear>;
					};
				};

				port@1 {
					reg = <1>;

					typec0_connector_ss: endpoint {
						remote-endpoint = <&atcphy0_typec_lanes>;
					};
				};
			};
		};
	};
};

/*
 * The controller's USB 2.0 pairs go to a VIA VL122 two-port hub on the
 * board (USB ID 2109:2122) whose downstream ports serve the two Type-C
 * connectors; only the back connector also has SuperSpeed lanes, wired
 * straight to the PHY. The controller is therefore always a host.
 */
&dwc3_0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	hub@1 {
		compatible = "usb2109,2122";
		reg = <1>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;

				hub_front: endpoint {
					remote-endpoint = <&typec1_connector_hs>;
				};
			};

			port@2 {
				reg = <2>;

				hub_rear: endpoint {
					remote-endpoint = <&typec0_connector_hs>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dwc3_0_ss: endpoint {
				remote-endpoint = <&atcphy0_usb3>;
			};
		};
	};
};

&dwc3_0_dart_0 {
	status = "okay";
};

&dwc3_0_dart_1 {
	status = "okay";
};

&atcphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			atcphy0_typec_lanes: endpoint {
				remote-endpoint = <&typec0_connector_ss>;
			};
		};

		port@1 {
			reg = <1>;

			atcphy0_usb3: endpoint {
				remote-endpoint = <&dwc3_0_ss>;
			};
		};
	};
};

&gfx_mbox {
	status = "okay";
};

&gfx1_mbox {
	status = "okay";
};

&gpu {
	status = "okay";
};

#include "hwmon-common.dtsi"
#include "hwmon-laptop.dtsi"

&pcie0 {
	/* The PIODMA guard stays closed until the retained bootstrap succeeds. */
	apple,piodma = <&pcie0_piodma_diag>;
	iommu-map = <0x100 &pcie0_dart 1 2>;
	iommu-map-mask = <0xffff>;
	pinctrl-0 = <&pcie0_clkreq>;
	pinctrl-names = "default";
	status = "okay";
};

&pcie0_port0 {
	reset-gpios = <&pinctrl_ap 114 GPIO_ACTIVE_LOW>;
	pwren-gpios = <&smc_gpio 8 GPIO_ACTIVE_HIGH>;
	max-link-speed = <2>;
	status = "okay";
};

&pinctrl_ap {
	pcie0_clkreq: pcie0-clkreq-pins {
		pinmux = <APPLE_PINMUX(101, 2)>;
	};
};

/* SID17 bootstrap; the arena stays owned until a full reset. */
&pcie0_dart {
	status = "okay";
	apple,dma-range = /bits/ 64 <0 0x1000000000>;
};

/ {
	pcie0_piodma_diag: piodma@390030000 {
		compatible = "apple,t8140-piodma-diagnostic";
		reg = <0x3 0x90030000 0x0 0x4000>,
		      <0x3 0x90034000 0x0 0x4000>,
		      <0x3 0x90038000 0x0 0x4000>;
		reg-names = "engine", "irq-aggregator", "fabric";
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1207 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_apcie_gp>;
		iommus = <&pcie0_dart 17>;
		apple,pcie-host = <&pcie0>;
	};
};

&pcie0_port0 {
	bus-range = <1 1>;
	wifi0: wifi@0,0 {
		compatible = "pci14c3,7932";
		reg = <0x10000 0 0 0 0>;
		/* Public m1n1 supplies this device's address at boot. */
		local-mac-address = [00 00 00 00 00 00];
	};
};

/* The loader publishes external resources after validating their firmware. */
#include "t8140-j700-dcpext.dtsi"

&display {
	iommus = <&disp0_dart 0>, <&dispext0_dart 0>;
};

&dcpext {
	clocks = <&clk_disp0_154>, <&clk_disp0_194>;
	clock-names = "clock-154", "clock-194";
	phys = <&atcphy0 PHY_TYPE_DP>;
	phy-names = "typec0";
	mux-controls = <&dpxbar0 0>;
	mux-control-names = "typec0";
	apple,typec-mux-indices = <2>;
	apple,typec-dptx-phys = <0>;
	apple,dcp-index = <1>;
};

&{/soc/dcp@416e00000/typec-routes/route@0} {
	status = "okay";
};

/* Allocate scanout buffers in the window used by the inherited firmware. */
&dcpext0_dart {
	apple,dma-range = <0x100 0x0 0x10 0x0>;
};
