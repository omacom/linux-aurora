/dts-v1/;

#include "t8140.dtsi"
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "apple,j700", "apple,t8140", "apple,arm-platform";
	model = "Apple MacBook Neo";

	aliases {
		nvram = &nvram;
		spi0 = &qspi;
		i2c2 = &i2c2;
		atcphy0 = &atcphy0;
		gpu = &gpu;
		keyboard = &keyboard;
		sep = &sep;
		serial0 = &serial0;
		pmp = &pmp;
		rtc0 = &smc_rtc;
		rtc1 = &pmu_rtc;
		wifi0 = &wifi0;
		/* used by the loader to hand over the display */
		dcp = &dcp;
		disp0 = &display;
		disp0-piodma = &disp0_piodma;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stdout-path = "serial0";
		/*
		 * Temporary: the secondary cores lose state in WFIT and the
		 * kernel does not yet stop using WFxT on T8140 by itself.
		 */
		bootargs = "arm64.nowfxt";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by loader */
			power-domains = <&ps_disp_cpu>;
			/* Format properties will be added by loader */
			status = "disabled";
			panel = <&panel>;
			post-init-providers = <&panel>;
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/* To be filled by loader */
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0 0x2 0>; /* To be filled by loader */
	};

	/*
	 * The J700 is fanless: the CPUs are the only cooling devices.  Every
	 * die sensor gets a zone that throttles both clusters, since they share
	 * one die and one heat spreader.  The power allocator splits the budget
	 * by the energy models, with the E cluster weighted three to one: its
	 * cores do several times more work per watt, so all-core loads keep
	 * them at full speed and trim the P cores instead.
	 *
	 * The SMC refreshes these readings about once a second and the die
	 * settles within that time, so the loop carries a full sample of delay,
	 * and the power a core draws per energy-model watt varies about 2.7x
	 * between integer and floating-point work.  The governor derives its
	 * gains from sustainable-power and the switch-on to control gap; 1.5 W
	 * over 37 C gives 40/81/8 mW per C, which held the clock within one
	 * P-state on both kinds of load (higher gains oscillate on the heavy
	 * one).  1.5 W lies inside the sustainable range measured at ~93 C:
	 * 1.1 W for floating-point and 2.5 W for integer loads.  The switch-on
	 * trip sits above the idle temperature with schedutil (48-53 C), so the
	 * controller, and with it any integral wind-up, resets whenever the
	 * machine rests.
	 *
	 * The governor grants no power to a cooling device that requests none,
	 * so above the switch-on trip an idle E cluster is sent to its lowest
	 * OPP, and work that wakes there runs at 816 MHz until the next
	 * evaluation.  With the performance governor the die idles at 58-70 C,
	 * above that trip, and in a ten-minute idle the E cluster spent 40% of
	 * its time capped this way.  The E maps therefore stop at cooling
	 * state 3, 1464 MHz, where the energy model puts the cost of the
	 * cluster's work within 0.5% of 816 MHz.  The lowest power of both
	 * clusters, 0.73 W, stays well under the 1.1 W sustainable on
	 * floating-point loads.
	 */
	thermal-zones {
		cpu-e0-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 0>;	/* Te05 */
			sustainable-power = <1500>;

			trips {
				cpu_e0_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_e0_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_e0_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_e0_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-e1-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 1>;	/* Te0S */
			sustainable-power = <1500>;

			trips {
				cpu_e1_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_e1_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_e1_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_e1_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p0-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 2>;	/* Tp01 */
			sustainable-power = <1500>;

			trips {
				cpu_p0_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p0_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p0_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p0_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p1-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 3>;	/* Tp05 */
			sustainable-power = <1500>;

			trips {
				cpu_p1_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p1_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p1_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p1_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p2-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 4>;	/* Tp09 */
			sustainable-power = <1500>;

			trips {
				cpu_p2_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p2_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p2_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p2_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};

		cpu-p3-thermal {
			polling-delay-passive = <500>;
			polling-delay = <500>;
			thermal-sensors = <&smc_hwmon 5>;	/* Tp0D */
			sustainable-power = <1500>;

			trips {
				cpu_p3_alert: trip-alert {
					temperature = <58000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_p3_control: trip-control {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				trip-critical {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_p3_control>;
					cooling-device =
						<&cpu_p0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu_p1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_p3_control>;
					cooling-device =
						<&cpu_e0 THERMAL_NO_LIMIT 3>,
						<&cpu_e1 THERMAL_NO_LIMIT 3>,
						<&cpu_e2 THERMAL_NO_LIMIT 3>,
						<&cpu_e3 THERMAL_NO_LIMIT 3>;
					contribution = <3072>;
				};
			};
		};
	};
};

#include "isp-imx558.dtsi"

&serial0 {
	status = "okay";
};

&pmp_dart {
	status = "okay";
};

&pmp_mbox {
	status = "okay";
};

&pmp_report {
	status = "okay";
};

&mcc {
	status = "okay";
};

&pmp {
	status = "okay";
};

&pmc {
	/*
	 * System power above DCS state 0 at each DCS state, GPU-bound.
	 *
	 * No thermal zone limits the DCS rail: the PMP drops its DCS vote
	 * when the GPU idles, and a power allocator zone on Tp0t made the
	 * limit oscillate between states 1 and 4 under GPU load. Without
	 * it Tp0t stays below the 110 C critical trips of the CPU zones.
	 */
	apple,dcs-power-microwatt = <0 919000 1453000 2058000 2407000>;
	status = "okay";
};

&pinctrl_ap {
	status = "okay";
};

&jpeg_dart {
	status = "okay";
};

&apr_dart {
	status = "okay";
};

&i2c2 {
	status = "okay";
};

&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			nvram: partition@24000 {
				label = "nvram";
				reg = <0x24000 0x1d0000>;
			};
		};
	};
};

&dcp_mbox {
	status = "okay";
};

&dcp {
	/* 2408x1506 at 219 ppi; 525 nits peak from the backlight node */
	panel: panel {
		compatible = "apple,panel-j700", "apple,panel";
		width-mm = <279>;
		height-mm = <175>;
		apple,max-brightness = <525>;
	};
};

&dpxbar0 {
	status = "okay";
};

&cpuidle {
	status = "okay";
};

&i2c0 {
	status = "okay";

	jack_codec: codec@48 {
		compatible = "cirrus,cs42l83";
		reg = <0x48>;
		reset-gpios = <&pinctrl_ap 103 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&pinctrl_ap>;
		interrupts = <104 IRQ_TYPE_LEVEL_LOW>;
		#sound-dai-cells = <0>;
		cirrus,ts-inv = <1>;
		sound-name-prefix = "Jack";
	};
};

&sep {
	status = "okay";
};

/*
 * Touch ID sensor.  Its rails are switched by the SMC through the pcLD key
 * rather than by a GPIO; the rail words are given in power-on order.  The
 * calibration file is per-device factory data and is not redistributable.
 */
&spi2 {
	status = "okay";

	fingerprint@0 {
		compatible = "apple,mesa-fingerprint";
		reg = <0>;
		spi-max-frequency = <8000000>;
		spi-cpol;
		spi-cs-setup-delay-ns = <20>;
		spi-cs-hold-delay-ns = <20>;
		interrupt-parent = <&pinctrl_ap>;
		interrupts = <135 IRQ_TYPE_EDGE_RISING>;
		apple,smc = <&smc>;
		apple,smc-power-key = "pcLD";
		apple,smc-power-rails = <0x01010000 0x01020000>;
		firmware-name = "apple/mesacal-j700.bin";
	};
};

&isp {
	apple,platform-id = <0x70>;
	apple,temporal-filter = <1>;
};

&aop_dart {
	status = "okay";
};

&aop_mbox {
	status = "okay";
};

&aop_setup_mbox {
	status = "okay";
};

&aop {
	status = "okay";
};

&aop_als {
	firmware-name = "apple/j700-aop-als-cal.bin";
};

&aop_audio {
	apple,chassis-name = "J700";
	apple,machine-kind = "MacBook Neo";
};

&admac_leap_ns {
	status = "okay";
};

&admac_base_ns {
	status = "okay";
};

&admac_leap_s {
	status = "okay";
};

/ {
	speaker_amp: audio-amplifier {
		compatible = "maxim,max98360a";
		sdmode-gpios = <&pinctrl_ap 105 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Speaker";
	};
	sound {
		compatible = "apple,j700-macaudio", "apple,macaudio";
		model = "MacBook Neo J700";
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 0>;
			};
			codec {
				sound-dai = <&jack_codec>;
			};
		};

		dai-link@1 {
			reg = <1>;
			link-name = "Speaker";

			cpu {
				sound-dai = <&aop_audio 4>;
			};
			codec {
				sound-dai = <&speaker_amp>;
			};
		};
	};
};

&smc {
	status = "okay";
};

&smc_hwmon {
	/*
	 * Further channels, reported to userspace. They follow the six CPU
	 * die temperatures in t8140.dtsi, which the thermal zones above
	 * refer to by index.
	 * Every key below is in the J700 SMC's key table as a read-only
	 * float, reads 10-99 C and moves between samples. The names follow
	 * the SMC key groups and are not otherwise verified.
	 */

	/* Channel 6: reads at or above every CPU die sensor under GPU load. */
	temperature-Tp0t {
		apple,key-id = "Tp0t";
		label = "SMC Tp0t";
	};

	temperature-TH0p {
		apple,key-id = "TH0p";
		label = "Storage (NAND)";
	};

	temperature-TW0p {
		apple,key-id = "TW0p";
		label = "Wi-Fi Module";
	};

	temperature-TUCp {
		apple,key-id = "TUCp";
		label = "USB-C Port";
	};

	temperature-TaTp {
		apple,key-id = "TaTp";
		label = "Ambient";
	};

	temperature-TCMz {
		apple,key-id = "TCMz";
		label = "Charger";
	};

	temperature-Ts0A {
		apple,key-id = "Ts0A";
		label = "Chassis 1";
	};

	temperature-Ts0I {
		apple,key-id = "Ts0I";
		label = "Chassis 2";
	};

	temperature-Ts0M {
		apple,key-id = "Ts0M";
		label = "Chassis 3";
	};

	/* The remaining live temperature keys; placement unknown */
	temperature-TBLp {
		apple,key-id = "TBLp";
		label = "SMC TBLp";
	};

	temperature-TCMb {
		apple,key-id = "TCMb";
		label = "SMC TCMb";
	};

	temperature-TPD0 {
		apple,key-id = "TPD0";
		label = "SMC TPD0";
	};

	temperature-TPD1 {
		apple,key-id = "TPD1";
		label = "SMC TPD1";
	};

	temperature-TPD2 {
		apple,key-id = "TPD2";
		label = "SMC TPD2";
	};

	temperature-TPD3 {
		apple,key-id = "TPD3";
		label = "SMC TPD3";
	};

	temperature-TPD4 {
		apple,key-id = "TPD4";
		label = "SMC TPD4";
	};

	temperature-TPD5 {
		apple,key-id = "TPD5";
		label = "SMC TPD5";
	};

	temperature-TPD6 {
		apple,key-id = "TPD6";
		label = "SMC TPD6";
	};

	temperature-TR5p {
		apple,key-id = "TR5p";
		label = "SMC TR5p";
	};

	temperature-TRD0 {
		apple,key-id = "TRD0";
		label = "SMC TRD0";
	};

	temperature-TRD1 {
		apple,key-id = "TRD1";
		label = "SMC TRD1";
	};

	temperature-TRD2 {
		apple,key-id = "TRD2";
		label = "SMC TRD2";
	};

	temperature-TRD3 {
		apple,key-id = "TRD3";
		label = "SMC TRD3";
	};

	temperature-TS0p {
		apple,key-id = "TS0p";
		label = "SMC TS0p";
	};

	temperature-TS1p {
		apple,key-id = "TS1p";
		label = "SMC TS1p";
	};

	temperature-TTSp {
		apple,key-id = "TTSp";
		label = "SMC TTSp";
	};

	temperature-TVA0 {
		apple,key-id = "TVA0";
		label = "SMC TVA0";
	};

	temperature-TVA1 {
		apple,key-id = "TVA1";
		label = "SMC TVA1";
	};

	temperature-TVD0 {
		apple,key-id = "TVD0";
		label = "SMC TVD0";
	};

	temperature-TVMR {
		apple,key-id = "TVMR";
		label = "SMC TVMR";
	};

	temperature-TVS0 {
		apple,key-id = "TVS0";
		label = "SMC TVS0";
	};

	temperature-TVS1 {
		apple,key-id = "TVS1";
		label = "SMC TVS1";
	};

	temperature-TVS3 {
		apple,key-id = "TVS3";
		label = "SMC TVS3";
	};

	temperature-TVS4 {
		apple,key-id = "TVS4";
		label = "SMC TVS4";
	};

	temperature-TVmS {
