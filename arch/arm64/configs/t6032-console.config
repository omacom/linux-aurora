# Console and network additions for the T6032 Mac Studio board.
# Merge over defconfig and asahi.config, then run olddefconfig and check
# that the symbols below survive.
#
# The PCIe ports take PERST from the AP pin controller and power from the
# SMC GPIO, and the NVMe controller needs the SART, so these are built in:
# a boot without an initramfs must reach the 10 Gbit port and the disk.
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_MFD_MACSMC=y
CONFIG_GPIO_MACSMC=y
CONFIG_APPLE_SART=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_APPLE=y
#
# The 10 Gbit port is a PCIe Ethernet device behind port02. The ADT names it
# lan-10gb and its i2c companion aqc-a, so it is taken to be an aQuantia
# AQtion part. The ADT gives no PCI ID.
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=y
#
# USB-A xHCI behind port03 (ASM3142) and USB Ethernet or ACM gadget hosts.
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_PCI_ASMEDIA=y
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
